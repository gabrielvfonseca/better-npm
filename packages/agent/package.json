    "vite-plugin-dts": "^4.0.0"
  },
  "description": "AI-native SDK for Dash — agent capability queries, semantic search, upgrade planning, audit, and safe transactional apply",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
