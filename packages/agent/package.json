{
  "name": "@dash/agent",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/"
  },
  "dependencies": {
    "@dash/search": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
