{
  "name": "better-npm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm turbo dev",
    "format": "pnpm exec biome format --write .",
    "lint:fix": "pnpm exec biome check --write .",
    "cargo:build": "cargo build --workspace",
    "cargo:test": "cargo test --workspace",
    "cargo:clippy": "cargo clippy --workspace -- -D warnings",
    "cargo:fmt": "cargo fmt --all -- --check",
    "gen": "pnpm exec plop",
    "gen:package": "pnpm exec plop package",
    "gen:app": "pnpm exec plop app",
    "gen:component": "pnpm exec plop component",
    "gen:hook": "pnpm exec plop hook",
    "gen:crate": "pnpm exec plop crate",
    "changeset": "pnpm exec changeset",
    "version": "pnpm exec changeset version",
    "release": "pnpm exec changeset publish",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "pnpm turbo db:migrate",
    "db:seed": "pnpm turbo db:seed",
    "db:studio": "pnpm turbo db:studio",
    "proto:gen": "buf generate",
    "proto:lint": "buf lint",
    "clean": "rm -rf node_modules **/dist **/.next **/target",
    "ci:check": "pnpm turbo lint typecheck build test && cargo clippy --workspace -- -D warnings && cargo fmt --all -- --check",
    "setup": "pnpm install && cargo build && pnpm proto:gen && pnpm db:migrate",
    "outdated": "pnpm exec npm-check-updates",
    "update": "pnpm exec npm-check-updates -u && pnpm install"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.28.0",
    "typescript": "^5.7.0",
    "plop": "^4.0.0",
    "vitest": "^3.0.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "@vitejs/plugin-react": "^4.7.0",
    "lefthook": "^1.10.0",
    "@types/node": "^22.0.0",
    "@types/bun": "^1.2.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "husky": "^9.1.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
