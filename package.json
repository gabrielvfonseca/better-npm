{
  "name": "better-npm",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.0",
  "workspaces": ["apps/*", "packages/*", "tools/*", "examples/*"],
  "scripts": {
    "dev": "bun run turbo dev",
    "build": "bun run turbo build",
    "test": "bun run turbo test",
    "lint": "bun run turbo lint",
    "typecheck": "bun run turbo typecheck",
    "format": "bunx @biomejs/biome format --write .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "cargo:build": "cargo build --workspace",
    "cargo:test": "cargo test --workspace",
    "cargo:clippy": "cargo clippy --workspace -- -D warnings",
    "cargo:fmt": "cargo fmt --all -- --check",
    "gen": "bunx plop",
    "gen:package": "bunx plop package",
    "gen:app": "bunx plop app",
    "gen:component": "bunx plop component",
    "gen:hook": "bunx plop hook",
    "gen:crate": "bunx plop crate",
    "changeset": "bunx changeset",
    "version": "bunx changeset version",
    "release": "bunx changeset publish",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "bun run turbo db:migrate",
    "db:seed": "bun run turbo db:seed",
    "db:studio": "bun run turbo db:studio",
    "proto:gen": "buf generate",
    "proto:lint": "buf lint",
    "clean": "rm -rf node_modules **/dist **/.next **/target",
    "ci:check": "bun run turbo lint typecheck build test && cargo clippy --workspace -- -D warnings && cargo fmt --all -- --check",
    "setup": "bun install && cargo build && bun run proto:gen && bun run db:migrate",
    "outdated": "bunx npm-check-updates",
    "update": "bunx npm-check-updates -u && bun install"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.28.0",
    "typescript": "^5.7.0",
    "plop": "^4.0.0",
    "vitest": "^3.0.0",
    "lefthook": "^1.10.0",
    "@types/node": "^22.0.0",
    "@types/bun": "^1.1.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "husky": "^9.1.0"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  }
}
