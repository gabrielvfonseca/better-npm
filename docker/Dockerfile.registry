# syntax=docker.io/docker/dockerfile:1.7

# Stage 1: Prune
FROM oven/bun:1.2-alpine AS pruner
WORKDIR /app
RUN bun install -g turbo
COPY package.json bun.lock turbo.json ./
COPY . .
RUN turbo prune --docker @dash/app-registry

# Stage 2: Dependencies
FROM oven/bun:1.2-alpine AS deps
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/bun.lock ./bun.lock
RUN --mount=type=cache,target=/root/.bun bun install --frozen-lockfile

# Stage 3: Builder
FROM oven/bun:1.2-alpine AS builder
WORKDIR /app
COPY --from=pruner /app/out/full/ .
COPY --from=deps /app/node_modules ./node_modules
ARG APP=registry
RUN --mount=type=cache,target=/root/.turbo bun run build --filter=@dash/app-registry

# Stage 4: Runner (distroless)
FROM gcr.io/distroless/nodejs22-debian12 AS runner
ARG APP=registry
WORKDIR /app
COPY --from=builder /app/apps/registry/dist ./dist
COPY --from=builder /app/apps/registry/package.json ./
COPY --from=builder /app/node_modules ./node_modules
USER nonroot
ENV NODE_ENV=production
ENV PORT=4000
EXPOSE 4000
CMD ["dist/index.js"]
