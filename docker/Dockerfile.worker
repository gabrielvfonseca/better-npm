# syntax=docker.io/docker/dockerfile:1.7

FROM oven/bun:1.2-alpine AS base
WORKDIR /app

ARG WORKER_NAME
ARG PACKAGE=workers-${WORKER_NAME}

# Stage 1: Prune
FROM base AS pruner
RUN bun install -g turbo
COPY package.json bun.lock turbo.json ./
COPY . .
ARG PACKAGE
RUN turbo prune --docker @better-npm/${PACKAGE}

# Stage 2: Dependencies
FROM base AS deps
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/bun.lock ./bun.lock
RUN --mount=type=cache,target=/root/.bun bun install --frozen-lockfile

# Stage 3: Builder
FROM base AS builder
WORKDIR /app
COPY --from=pruner /app/out/full/ .
COPY --from=deps /app/node_modules ./node_modules
ARG WORKER_NAME
ARG PACKAGE
RUN --mount=type=cache,target=/root/.turbo bun run build --filter=@better-npm/${PACKAGE}

# Stage 4: Runner (distroless)
FROM gcr.io/distroless/nodejs22-debian12 AS runner
ARG WORKER_NAME
WORKDIR /app
COPY --from=builder /app/apps/workers/${WORKER_NAME}/dist ./dist
COPY --from=builder /app/apps/workers/${WORKER_NAME}/package.json ./
COPY --from=builder /app/node_modules ./node_modules
USER nonroot
ENV NODE_ENV=production
CMD ["dist/index.js"]
