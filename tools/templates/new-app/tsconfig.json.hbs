{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    {{#ifEquals framework 'nextjs'}}
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    {{else}}
    "outDir": "dist",
    "rootDir": "src",
    {{/ifEquals}}
    "outDir": "dist"
  },
  "include": [
    "src"
    {{#ifEquals framework 'nextjs'}}
    , "next-env.d.ts"
    {{/ifEquals}}
  ]
}
