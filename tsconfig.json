{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "paths": {
      "@better-npm/sdk": ["./packages/sdk/src"],
      "@better-npm/sdk/*": ["./packages/sdk/src/*"],
      "@better-npm/client": ["./packages/client/src"],
      "@better-npm/client/*": ["./packages/client/src/*"],
      "@better-npm/types": ["./packages/types/src"],
      "@better-npm/types/*": ["./packages/types/src/*"],
      "@better-npm/schemas": ["./packages/schemas/src"],
      "@better-npm/schemas/*": ["./packages/schemas/src/*"],
      "@better-npm/design-system": ["./packages/design-system/src"],
      "@better-npm/design-system/*": ["./packages/design-system/src/*"],
      "@better-npm/hooks": ["./packages/hooks/src"],
      "@better-npm/hooks/*": ["./packages/hooks/src/*"],
      "@better-npm/utils": ["./packages/utils/src"],
      "@better-npm/utils/*": ["./packages/utils/src/*"],
      "@better-npm/logger": ["./packages/logger/src"],
      "@better-npm/logger/*": ["./packages/logger/src/*"],
      "@better-npm/config": ["./packages/config/src"],
      "@better-npm/config/*": ["./packages/config/src/*"],
      "@better-npm/auth": ["./packages/auth/src"],
      "@better-npm/auth/*": ["./packages/auth/src/*"],
      "@better-npm/validation": ["./packages/validation/src"],
      "@better-npm/validation/*": ["./packages/validation/src/*"],
      "@better-npm/analytics": ["./packages/analytics/src"],
      "@better-npm/analytics/*": ["./packages/analytics/src/*"],
      "@better-npm/telemetry": ["./packages/telemetry/src"],
      "@better-npm/telemetry/*": ["./packages/telemetry/src/*"],
      "@better-npm/testing": ["./packages/testing/src"],
      "@better-npm/testing/*": ["./packages/testing/src/*"],
      "@better-npm/shared": ["./packages/shared/src"],
      "@better-npm/shared/*": ["./packages/shared/src/*"],
      "@better-npm/flags": ["./packages/flags/src"],
      "@better-npm/flags/*": ["./packages/flags/src/*"],
      "@better-npm/storage": ["./packages/storage/src"],
      "@better-npm/storage/*": ["./packages/storage/src/*"],
      "@better-npm/cache": ["./packages/cache/src"],
      "@better-npm/cache/*": ["./packages/cache/src/*"],
      "@better-npm/contracts": ["./packages/contracts/src"],
      "@better-npm/contracts/*": ["./packages/contracts/src/*"],
      "@better-npm/api": ["./packages/api/src"],
      "@better-npm/api/*": ["./packages/api/src/*"],
      "@better-npm/mdx": ["./packages/mdx/src"],
      "@better-npm/mdx/*": ["./packages/mdx/src/*"],
      "@better-npm/markdown": ["./packages/markdown/src"],
      "@better-npm/markdown/*": ["./packages/markdown/src/*"],
      "@better-npm/search": ["./packages/search/src"],
      "@better-npm/search/*": ["./packages/search/src/*"],
      "@better-npm/icons": ["./packages/icons/src"],
      "@better-npm/icons/*": ["./packages/icons/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage", "target"]
}
