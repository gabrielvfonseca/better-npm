{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "paths": {
      "@dash/sdk": ["./packages/sdk/src"],
      "@dash/sdk/*": ["./packages/sdk/src/*"],
      "@dash/client": ["./packages/client/src"],
      "@dash/client/*": ["./packages/client/src/*"],
      "@dash/types": ["./packages/types/src"],
      "@dash/types/*": ["./packages/types/src/*"],
      "@dash/schemas": ["./packages/schemas/src"],
      "@dash/schemas/*": ["./packages/schemas/src/*"],
      "@dash/design-system": ["./packages/design-system/src"],
      "@dash/design-system/*": ["./packages/design-system/src/*"],
      "@dash/hooks": ["./packages/hooks/src"],
      "@dash/hooks/*": ["./packages/hooks/src/*"],
      "@dash/utils": ["./packages/utils/src"],
      "@dash/utils/*": ["./packages/utils/src/*"],
      "@dash/logger": ["./packages/logger/src"],
      "@dash/logger/*": ["./packages/logger/src/*"],
      "@dash/config": ["./packages/config/src"],
      "@dash/config/*": ["./packages/config/src/*"],
      "@dash/auth": ["./packages/auth/src"],
      "@dash/auth/*": ["./packages/auth/src/*"],
      "@dash/validation": ["./packages/validation/src"],
      "@dash/validation/*": ["./packages/validation/src/*"],
      "@dash/analytics": ["./packages/analytics/src"],
      "@dash/analytics/*": ["./packages/analytics/src/*"],
      "@dash/telemetry": ["./packages/telemetry/src"],
      "@dash/telemetry/*": ["./packages/telemetry/src/*"],
      "@dash/testing": ["./packages/testing/src"],
      "@dash/testing/*": ["./packages/testing/src/*"],
      "@dash/shared": ["./packages/shared/src"],
      "@dash/shared/*": ["./packages/shared/src/*"],
      "@dash/flags": ["./packages/flags/src"],
      "@dash/flags/*": ["./packages/flags/src/*"],
      "@dash/storage": ["./packages/storage/src"],
      "@dash/storage/*": ["./packages/storage/src/*"],
      "@dash/cache": ["./packages/cache/src"],
      "@dash/cache/*": ["./packages/cache/src/*"],
      "@dash/contracts": ["./packages/contracts/src"],
      "@dash/contracts/*": ["./packages/contracts/src/*"],
      "@dash/api": ["./packages/api/src"],
      "@dash/api/*": ["./packages/api/src/*"],
      "@dash/mdx": ["./packages/mdx/src"],
      "@dash/mdx/*": ["./packages/mdx/src/*"],
      "@dash/markdown": ["./packages/markdown/src"],
      "@dash/markdown/*": ["./packages/markdown/src/*"],
      "@dash/search": ["./packages/search/src"],
      "@dash/search/*": ["./packages/search/src/*"],
      "@dash/icons": ["./packages/icons/src"],
      "@dash/icons/*": ["./packages/icons/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage", "target"]
}
